<?xml version="1.0" encoding="utf-8"?>
<!--
  Область действия — только Tests/. NuGet ищет конфиг, поднимаясь вверх от
  папки проекта, так что сборка Assembly-CSharp.csproj в корне этого файла
  не видит и остаётся ровно такой, какой была.

  Зачем он нужен: в глобальной конфигурации машины nuget.org отключён, а
  тестовые пакеты тянуть неоткуда. Правим здесь, а не глобально, чтобы
  настройка машины осталась делом машины, а требования репозитория —
  делом репозитория (и чтобы CI восстанавливал пакеты без ручной настройки).

  <clear/> в обоих списках обязателен: без очистки disabledPackageSources
  запрет из пользовательского конфига дошёл бы и сюда.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
</configuration>
